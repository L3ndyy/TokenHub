<Window x:Class="TokenHub.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenHub — команды"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Transparent" AllowsTransparency="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="CommandItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Br.ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Br.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Br.OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource Br.Popup}" BorderBrush="{DynamicResource Br.CardBorder}"
            BorderThickness="1" CornerRadius="10" Padding="12">
        <StackPanel>
            <TextBox x:Name="TxtFilter" Style="{StaticResource Field}"
                     TextChanged="Filter_Changed"
                     AutomationProperties.Name="Поиск команды"
                     KeyDown="Filter_KeyDown" />
            <ListBox x:Name="LstCommands" Margin="0,10,0,0" BorderThickness="0"
                     Background="Transparent" MaxHeight="340"
                     ItemContainerStyle="{StaticResource CommandItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="List_DoubleClick"
                     AutomationProperties.Name="Список команд" />
            <TextBlock Style="{StaticResource Caption}" Margin="2,8,0,0"
                       Text="Enter — выполнить · Esc — закрыть · ↑ ↓ — выбор" />
        </StackPanel>
    </Border>
</Window>
