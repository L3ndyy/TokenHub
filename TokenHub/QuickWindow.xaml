<Window x:Class="TokenHub.QuickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenHub — статус"
        Width="360" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Border Background="{DynamicResource Br.Popup}" BorderBrush="{DynamicResource Br.CardBorder}"
            BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel>
            <DockPanel>
                <Ellipse x:Name="TrayDot" DockPanel.Dock="Left" Width="9" Height="9"
                         Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtHead" Text="TokenHub" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource Br.Text}" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock x:Name="TxtSummary" Style="{StaticResource Caption}" Margin="0,8,0,0"
                       TextWrapping="Wrap" />

            <StackPanel x:Name="KeyList" Margin="0,10,0,0" />

            <WrapPanel Margin="0,12,0,0">
                <Button Style="{StaticResource AccentButton}" Content="Открыть" Margin="0,0,8,8"
                        Click="Open_Click" AutomationProperties.Name="Открыть TokenHub" />
                <Button Style="{StaticResource SubtleButton}" Content="Проверить" Margin="0,0,8,8"
                        Click="Check_Click" AutomationProperties.Name="Проверить ключи" />
                <Button Style="{StaticResource SubtleButton}" Content="Ключи" Margin="0,0,8,8"
                        Click="Keys_Click" AutomationProperties.Name="Открыть раздел ключей" />
                <Button Style="{StaticResource SubtleButton}" Content="Журнал" Margin="0,0,8,8"
                        Click="Journal_Click" AutomationProperties.Name="Открыть журнал событий" />
            </WrapPanel>

            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                       Text="Esc или щелчок мимо окна — закрыть" />
        </StackPanel>
    </Border>
</Window>