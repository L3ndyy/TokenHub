<Window x:Class="TokenHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenHub"
        Height="660" Width="1040" MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        Icon="Assets/app.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="5" Background="Transparent">
                            <ContentPresenter x:Name="Cp" Margin="14,6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Br.ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Br.Accent}" />
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource Br.OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    <LinearGradientBrush x:Key="TopGlow" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1CFFFFFF" Offset="0" />
            <GradientStop Color="#00FFFFFF" Offset="0.45" />
        </LinearGradientBrush>
    </Window.Resources>

    <Border Background="{DynamicResource Br.Layer}" BorderBrush="{DynamicResource Br.CardBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- soft top highlight, sits under every panel -->
            <Border Grid.RowSpan="3" IsHitTestVisible="False" Background="{StaticResource TopGlow}" />

            <!-- ================= title bar ================= -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <!-- the same monogram as the app icon, drawn vector so it stays sharp at 22 px -->
                    <Border Width="22" Height="22" CornerRadius="5" VerticalAlignment="Center"
                            BorderBrush="#1E141E46" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#FFFFFFFF" Offset="0" />
                                <GradientStop Color="#FFE9EEFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="TH" FontSize="10" FontWeight="Bold" Foreground="#FF3858F5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="TokenHub" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Br.Text}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMin" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            Click="Caption_Click" Tag="min" ToolTip="Свернуть в трей"
                            AutomationProperties.Name="Свернуть окно в трей" />
                    <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            Click="Caption_Click" Tag="max" ToolTip="Развернуть"
                            AutomationProperties.Name="Развернуть окно" />
                    <Button x:Name="BtnClose" Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                            Click="Caption_Click" Tag="close" ToolTip="Закрыть в трей"
                            AutomationProperties.Name="Закрыть окно" />
                </StackPanel>
            </Grid>

            <!-- ================= body ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="218" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="10,6,6,10">
                    <RadioButton x:Name="NavHome" GroupName="nav" Style="{StaticResource NavItem}"
                                 IsChecked="True" Tag="home" Checked="Nav_Checked"
                                 AutomationProperties.Name="Главная">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Главная" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavLaunch" GroupName="nav" Style="{StaticResource NavItem}"
                                 Tag="launch" Checked="Nav_Checked"
                                 AutomationProperties.Name="Запуск">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Запуск" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavNetwork" GroupName="nav" Style="{StaticResource NavItem}"
                                 Tag="network" Checked="Nav_Checked"
                                 AutomationProperties.Name="Сеть и прокси">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Сеть и прокси" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavKeys" GroupName="nav" Style="{StaticResource NavItem}"
                                 Tag="keys" Checked="Nav_Checked"
                                 AutomationProperties.Name="Ключи">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Ключи" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavSkills" GroupName="nav" Style="{StaticResource NavItem}"
                                 Tag="skills" Checked="Nav_Checked"
                                 AutomationProperties.Name="Скиллы">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Скиллы" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavSettings" GroupName="nav" Style="{StaticResource NavItem}"
                                 Tag="settings" Checked="Nav_Checked"
                                 AutomationProperties.Name="Настройки">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Настройки" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,6,20,14">
                    <Grid>

                        <!-- ============ HOME ============ -->
                        <StackPanel x:Name="PanelHome" Margin="18,10,0,0">
                            <TextBlock Text="Главная" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Subtitle}" Text="Состояние сервисов и быстрый запуск" />

                            <Border x:Name="UpdateBanner" Style="{StaticResource Card}" Margin="0,18,0,0"
                                    Visibility="Collapsed">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="16,0,0,0">
                                        <Button Style="{StaticResource AccentButton}" Content="Обновить"
                                                Click="UpdateBanner_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Позже" Margin="8,0,0,0"
                                                Click="DismissUpdateBanner_Click" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtUpdateTitle" Style="{StaticResource CardTitle}"
                                                   Text="Доступно обновление" />
                                        <TextBlock x:Name="TxtUpdateDetail" Style="{StaticResource Caption}"
                                                   Margin="0,4,0,0" Text="" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>


                                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <Ellipse x:Name="DotOc" DockPanel.Dock="Right" Width="10" Height="10"
                                                     Fill="{DynamicResource Br.Muted}" VerticalAlignment="Center" />
                                            <TextBlock Text="OpenCode" Style="{StaticResource CardTitle}" />
                                        </DockPanel>
                                        <TextBlock x:Name="HomeOcStatus" Style="{StaticResource Body}" Margin="0,8,0,0" Text="Проверка…" />
                                        <TextBlock x:Name="HomeOcDetail" Style="{StaticResource Caption}" Margin="0,4,0,0" Text="" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Style="{StaticResource AccentButton}" Content="Запустить" Click="LaunchOpenCode_Click" />
                                            <Button Style="{StaticResource SubtleButton}" Content="Перезапустить" Margin="8,0,0,0" Click="RestartOpenCode_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <Ellipse x:Name="DotProxy" DockPanel.Dock="Right" Width="10" Height="10"
                                                     Fill="{DynamicResource Br.Muted}" VerticalAlignment="Center" />
                                            <TextBlock Text="Прокси Token Harbor" Style="{StaticResource CardTitle}" />
                                        </DockPanel>
                                        <TextBlock x:Name="HomeProxyStatus" Style="{StaticResource Body}" Margin="0,8,0,0" Text="Проверка…" />
                                        <TextBlock x:Name="HomeProxyDetail" Style="{StaticResource Caption}" Margin="0,4,0,0" Text="" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Style="{StaticResource AccentButton}" Content="Проверить" Click="CheckProxy_Click" />
                                            <Button Style="{StaticResource SubtleButton}" Content="Копировать адрес" Margin="8,0,0,0" Click="CopyBaseUrl_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </Grid>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}"
                                                Content="Сбросить" Click="ResetStats_Click" VerticalAlignment="Center" />
                                        <TextBlock Text="Статистика пула" Style="{StaticResource CardTitle}" />
                                    </DockPanel>
                                    <TextBlock x:Name="TxtPoolStats" Style="{StaticResource Mono}" Margin="0,12,0,0" Text="Нет данных." />
                                    <Border Height="42" Margin="0,12,0,0" CornerRadius="6"
                                            Background="{DynamicResource Br.Control}"
                                            BorderBrush="{DynamicResource Br.ControlBorder}" BorderThickness="1"
                                            AutomationProperties.Name="График запросов">
                                        <Canvas x:Name="SparkCanvas" Height="40" Margin="4,0" ClipToBounds="True" />
                                    </Border>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                               Text="График обновляется каждые 2 секунды, пока окно открыто." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Быстрые действия" Style="{StaticResource CardTitle}" />
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Style="{StaticResource AccentButton}" Content="Настроить всё"
                                                Margin="0,0,8,8" Click="SetupEverything_Click"
                                                AutomationProperties.Name="Настроить всё одной кнопкой" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Проверить всё"
                                                Margin="0,0,8,8" Click="CheckAll_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Журнал событий"
                                                Margin="0,0,8,8" Click="OpenJournal_Click" />
                                        <Button x:Name="BtnMoreHome" Style="{StaticResource SubtleButton}"
                                                Margin="0,0,8,8" Click="ToggleMore_Click" Tag="MoreHome"
                                                AutomationProperties.Name="Показать остальные действия">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="TxtMoreHome" Text="Ещё" VerticalAlignment="Center" />
                                                <TextBlock x:Name="IcoMoreHome" Text="&#xE70D;" VerticalAlignment="Center"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                                           Margin="8,1,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel x:Name="MoreHome" Visibility="Collapsed" Margin="0,4,0,0">
                                        <Button x:Name="BtnUpdate" Style="{StaticResource SubtleButton}" Content="Проверить обновление" Margin="0,0,8,8" Click="CheckUpdate_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Обзор программы" Margin="0,0,8,8" Click="ShowIntro_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Настроить OpenCode" Margin="0,0,8,8" Click="OpenWizard_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Диагностика" Margin="0,0,8,8" Click="ExportDiagnostics_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Открыть конфиг OpenCode" Margin="0,0,8,8" Click="OpenConfig_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Папка TokenHub" Margin="0,0,8,8" Click="OpenHubFolder_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ LAUNCH ============ -->
                        <StackPanel x:Name="PanelLaunch" Margin="18,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="Запуск" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Subtitle}" Text="Один клик — и всё открыто" />

                            <UniformGrid Columns="2" Margin="0,18,0,0">

                                <Button Style="{StaticResource TileButton}" Margin="0,0,8,8" Click="LaunchOpenCode_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource Br.Control}"
                                                BorderBrush="{DynamicResource Br.ControlBorder}" BorderThickness="1">
                                            <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="{DynamicResource Br.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="OpenCode" FontWeight="SemiBold" Foreground="{DynamicResource Br.Text}" />
                                            <TextBlock Text="Агент в терминале и приложении" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource TileButton}" Margin="8,0,0,8" Click="RestartOpenCode_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource Br.Control}"
                                                BorderBrush="{DynamicResource Br.ControlBorder}" BorderThickness="1">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="{DynamicResource Br.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Перезапустить OpenCode" FontWeight="SemiBold" Foreground="{DynamicResource Br.Text}" />
                                            <TextBlock Text="Подхватить новый конфиг" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource TileButton}" Margin="0,8,8,0" Click="OpenTerminal_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource Br.Control}"
                                                BorderBrush="{DynamicResource Br.ControlBorder}" BorderThickness="1">
                                            <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="{DynamicResource Br.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Терминал" FontWeight="SemiBold" Foreground="{DynamicResource Br.Text}" />
                                            <TextBlock Text="В рабочей папке проекта" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource TileButton}" Margin="8,8,0,0" Click="OpenConfig_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource Br.Control}"
                                                BorderBrush="{DynamicResource Br.ControlBorder}" BorderThickness="1">
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="{DynamicResource Br.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Конфиг OpenCode" FontWeight="SemiBold" Foreground="{DynamicResource Br.Text}" />
                                            <TextBlock Text="opencode.json" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                            </UniformGrid>
                        </StackPanel>

                        <!-- ============ NETWORK ============ -->
                        <StackPanel x:Name="PanelNetwork" Margin="18,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="Сеть и прокси" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Subtitle}" Text="Маршрут запросов к Token Harbor" />

                            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="Текущий режим" Style="{StaticResource CardTitle}" />
                                    <TextBlock x:Name="TxtMode" Style="{StaticResource Body}" Margin="0,8,0,0" Text="…" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Style="{StaticResource AccentButton}" Content="Включить прокси" Click="UseProxy_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Вернуть напрямую" Margin="8,0,0,0" Click="UseDirect_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Адреса" Style="{StaticResource CardTitle}" />

                                    <TextBlock Text="Адрес для OpenCode (baseURL)" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtBaseUrl" Style="{StaticResource Field}" IsReadOnly="True" Grid.Column="0" />
                                        <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Content="Копировать" Margin="8,0,0,0" Click="CopyBaseUrl_Click" />
                                    </Grid>

                                    <TextBlock Text="Прокси" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtProxyBase" Style="{StaticResource Field}" Grid.Column="0" TextChanged="ProxyField_Changed"
                                                 AutomationProperties.Name="Адрес прокси" />
                                        <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Content="Открыть" Margin="8,0,0,0" Click="OpenProxyFolder_Click" />
                                    </Grid>

                                    <TextBlock Text="Секрет (путь прокси)" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtSecret" Style="{StaticResource Field}" Grid.Column="0" TextChanged="ProxyField_Changed"
                                                 AutomationProperties.Name="Секрет прокси" />
                                        <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Content="Копировать" Margin="8,0,0,0" Click="CopySecret_Click" />
                                    </Grid>

                                    <TextBlock Text="Куда проксируем" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                                    <TextBox x:Name="TxtUpstream" Style="{StaticResource Field}" TextChanged="ProxyField_Changed" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Проверки" Style="{StaticResource CardTitle}" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Style="{StaticResource AccentButton}" Content="Прокси" Margin="0,0,8,8" Click="CheckProxy_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Модели через прокси" Margin="0,0,8,8" Click="CheckModels_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Напрямую (для сравнения)" Margin="0,0,8,8" Click="CheckDirect_Click" />
                                    </WrapPanel>
                                    <TextBox x:Name="TxtChecks" Style="{StaticResource Field}"
                                             FontFamily="Cascadia Mono, Consolas" AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="120" IsReadOnly="True" Margin="0,4,0,0" VerticalContentAlignment="Top" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ KEYS ============ -->
                        <StackPanel x:Name="PanelKeys" Margin="18,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="Ключи Token Harbor" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Subtitle}" Text="Пул ключей с автопереключением" />

                            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                                <StackPanel>
                                    <DockPanel>
                                        <Ellipse x:Name="DotPool" DockPanel.Dock="Right" Width="10" Height="10"
                                                 Fill="{DynamicResource Br.Muted}" VerticalAlignment="Center" />
                                        <TextBlock Text="Локальный прокси" Style="{StaticResource CardTitle}" />
                                    </DockPanel>
                                    <TextBlock x:Name="TxtPoolState" Style="{StaticResource Body}" Margin="0,8,0,0" Text="Проверка..." />
                                    <TextBlock x:Name="TxtPoolHint" Style="{StaticResource Caption}" Margin="0,6,0,0" Text="" />
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Style="{StaticResource AccentButton}" Content="Применить в OpenCode" Margin="0,0,8,8" Click="ApplyPool_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Применить и перезапустить" Margin="0,0,8,8" Click="ApplyPoolRestart_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Проверить все ключи" Margin="0,0,8,8" Click="CheckAllKeys_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Margin="0,0,8,8" Click="ToggleMore_Click" Tag="MorePool"
                                                AutomationProperties.Name="Показать остальные действия пула">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="TxtMorePool" Text="Ещё" VerticalAlignment="Center" />
                                                <TextBlock x:Name="IcoMorePool" Text="&#xE70D;" VerticalAlignment="Center"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                                           Margin="8,1,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel x:Name="MorePool" Visibility="Collapsed" Margin="0,4,0,0">
                                        <Button Style="{StaticResource SubtleButton}" Content="Копировать адрес" Margin="0,0,8,8" Click="CopyPoolUrl_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Сбросить паузы и ошибки" Margin="0,0,8,8" Click="ResetPool_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Экспорт ключей" Margin="0,0,8,8" Click="ExportKeys_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Импорт ключей" Margin="0,0,8,8" Click="ImportKeys_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Добавить ключ" Style="{StaticResource CardTitle}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtNewKey" Style="{StaticResource Field}" Grid.Column="0"
                                                 AutomationProperties.Name="Новый ключ Token Harbor" />
                                        <Button Grid.Column="1" Style="{StaticResource AccentButton}" Content="Добавить"
                                                Margin="8,0,0,0" Click="AddKey_Click"
                                                AutomationProperties.Name="Добавить ключ в пул" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                               Text="Ключ вида thk_live_… из личного кабинета tokenharbor.ai. После добавления он сразу проверяется." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <DockPanel>
                                        <ToggleButton x:Name="TglFailover" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                      VerticalAlignment="Center" Checked="Failover_Changed" Unchecked="Failover_Changed" />
                                        <StackPanel>
                                            <TextBlock Text="Автопереключение" Style="{StaticResource CardTitle}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="Запрос уйдёт на следующий ключ, если этот исчерпан" />
                                        </StackPanel>
                                    </DockPanel>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtSearch" Grid.Column="0" Style="{StaticResource Field}"
                                                 TextChanged="SearchKeys_Changed"
                                                 ToolTip="Поиск по названию, статусу или маске ключа"
                                                 AutomationProperties.Name="Поиск по ключам" />
                                        <ComboBox x:Name="CmbSort" Grid.Column="1" Width="160" Margin="8,0,0,0"
                                                  Style="{StaticResource Picker}" SelectionChanged="SortKeys_Changed"
                                                  AutomationProperties.Name="Сортировка ключей">
                                            <ComboBoxItem Content="Порядок пула" Tag="manual" />
                                            <ComboBoxItem Content="По статусу" Tag="status" />
                                            <ComboBoxItem Content="По названию" Tag="name" />
                                        </ComboBox>
                                    </Grid>

                                    <StackPanel x:Name="KeysList" Margin="0,12,0,0" />
                                    <TextBlock x:Name="TxtKeysEmpty" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                               Text="Ключей пока нет — добавьте первый." />
                                    <TextBlock x:Name="TxtKeysHint" Style="{StaticResource Caption}" Margin="0,10,0,0"
                                               Text="Ключи пробуются сверху вниз. Первый в списке — главный. Перетащите строку мышью, чтобы изменить порядок." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Поведение пула" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Стратегия выбора ключа" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                                    <ComboBox x:Name="CmbStrategy" Width="260" HorizontalAlignment="Left"
                                              Style="{StaticResource Picker}" SelectionChanged="Strategy_Changed"
                                              AutomationProperties.Name="Стратегия выбора ключа">
                                        <ComboBoxItem Content="По порядку (сверху вниз)" Tag="ordered" />
                                        <ComboBoxItem Content="По кругу (round-robin)" Tag="roundRobin" />
                                        <ComboBoxItem Content="Реже использованный" Tag="leastUsed" />
                                    </ComboBox>
                                    <TextBlock Text="Пауза исчерпанного ключа, минут" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtCooldown" Grid.Column="0" Width="90" Style="{StaticResource Field}"
                                                 TextChanged="Cooldown_Changed"
                                                 AutomationProperties.Name="Пауза ключа в минутах" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Text="Если сервер пришлёт Retry-After, он имеет приоритет над этим значением." />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <DockPanel>
                                        <Ellipse x:Name="DotService" DockPanel.Dock="Right" Width="10" Height="10"
                                                 Fill="{DynamicResource Br.Muted}" VerticalAlignment="Center" />
                                        <TextBlock Text="Служба Windows" Style="{StaticResource CardTitle}" />
                                    </DockPanel>
                                    <TextBlock x:Name="TxtServiceState" Style="{StaticResource Body}" Margin="0,8,0,0" Text="Проверка..." />
                                    <TextBlock x:Name="TxtServiceHint" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                               Text="Служба держит пул ключей запущенным, даже когда окно TokenHub закрыто. Установка и управление требуют прав администратора — появится один запрос UAC." />
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Style="{StaticResource AccentButton}" Content="Установить и запустить" Margin="0,0,8,8" Click="ServiceInstall_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Обновить" Margin="0,0,8,8" Click="ServiceRefresh_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Margin="0,0,8,8" Click="ToggleMore_Click" Tag="MoreService"
                                                AutomationProperties.Name="Показать остальные действия службы">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="TxtMoreService" Text="Ещё" VerticalAlignment="Center" />
                                                <TextBlock x:Name="IcoMoreService" Text="&#xE70D;" VerticalAlignment="Center"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                                           Margin="8,1,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel x:Name="MoreService" Visibility="Collapsed" Margin="0,4,0,0">
                                        <Button Style="{StaticResource SubtleButton}" Content="Запустить" Margin="0,0,8,8" Click="ServiceStart_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Остановить" Margin="0,0,8,8" Click="ServiceStop_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Обновить файлы службы" Margin="0,0,8,8" Click="ServiceUpdate_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Удалить" Margin="0,0,8,8" Click="ServiceUninstall_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ SKILLS ============ -->
                        <StackPanel x:Name="PanelSkills" Margin="18,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="Скиллы" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Subtitle}" Text="Готовые наборы инструкций для OpenCode" />

                            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtSkillsState" Style="{StaticResource Body}" Text="Проверка..." />
                                    <TextBlock x:Name="TxtSkillsPath" Style="{StaticResource Mono}" Margin="0,8,0,0"
                                               Text="..." TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Style="{StaticResource AccentButton}" Content="Установить все"
                                                Margin="0,0,8,8" Click="InstallAllSkills_Click"
                                                AutomationProperties.Name="Установить все скиллы" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Открыть папку"
                                                Margin="0,0,8,8" Click="OpenSkillsFolder_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Каталог по назначению" Style="{StaticResource CardTitle}" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,12,0" TextWrapping="Wrap"
                                                       Text="Разделы свёрнуты, чтобы список не расплывался. Нажмите на раздел, а затем на название скилла — раскроются описание и кнопка установки." />
                                        </StackPanel>
                                        <TextBox x:Name="TxtSkillSearch" Grid.Column="1" Width="230"
                                                 Style="{StaticResource Field}" TextChanged="SkillSearch_Changed"
                                                 AutomationProperties.Name="Поиск по скиллам" />
                                    </Grid>
                                    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" Margin="0,14,0,4">
                                        <StackPanel x:Name="SkillsGroups" Margin="0,0,6,0" />
                                    </ScrollViewer>
                                    <TextBlock x:Name="TxtSkillsHint" Style="{StaticResource Caption}" Margin="0,12,0,0"
                                               Text="" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ SETTINGS ============ -->
                        <StackPanel x:Name="PanelSettings" Margin="18,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="Настройки" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Subtitle}" Text="Внешний вид и поведение" />

                            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="Тема" Style="{StaticResource CardTitle}" />
                                    <Border CornerRadius="7" Background="{DynamicResource Br.Control}"
                                            BorderBrush="{DynamicResource Br.ControlBorder}" BorderThickness="1"
                                            Margin="0,12,0,0" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Margin="3">
                                            <RadioButton x:Name="ThemeSystem" GroupName="theme" Style="{StaticResource Segment}"
                                                         Content="Как в системе" Tag="system" Checked="Theme_Checked" />
                                            <RadioButton x:Name="ThemeDark" GroupName="theme" Style="{StaticResource Segment}"
                                                         Content="Тёмная" Tag="dark" Checked="Theme_Checked" />
                                            <RadioButton x:Name="ThemeLight" GroupName="theme" Style="{StaticResource Segment}"
                                                         Content="Светлая" Tag="light" Checked="Theme_Checked" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Акцентный цвет" Style="{StaticResource CardTitle}" Margin="0,20,0,0" />
                                    <WrapPanel x:Name="AccentRow" Margin="0,12,0,0">
                                        <Button Style="{StaticResource Swatch}" Background="#FF4CC2FF" Tag="system" Click="Accent_Click" Margin="0,0,8,0" ToolTip="Системный" />
                                        <Button Style="{StaticResource Swatch}" Background="#FF4CC2FF" Tag="#FF4CC2FF" Click="Accent_Click" Margin="0,0,8,0" ToolTip="Голубой" />
                                        <Button Style="{StaticResource Swatch}" Background="#FF0078D4" Tag="#FF0078D4" Click="Accent_Click" Margin="0,0,8,0" ToolTip="Синий" />
                                        <Button Style="{StaticResource Swatch}" Background="#FF8B5CF6" Tag="#FF8B5CF6" Click="Accent_Click" Margin="0,0,8,0" ToolTip="Фиолетовый" />
                                        <Button Style="{StaticResource Swatch}" Background="#FF10B981" Tag="#FF10B981" Click="Accent_Click" Margin="0,0,8,0" ToolTip="Зелёный" />
                                        <Button Style="{StaticResource Swatch}" Background="#FFF43F5E" Tag="#FFF43F5E" Click="Accent_Click" Margin="0,0,8,0" ToolTip="Розовый" />
                                        <Button Style="{StaticResource Swatch}" Background="#FFF59E0B" Tag="#FFF59E0B" Click="Accent_Click" Margin="0,0,8,0" ToolTip="Янтарный" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <DockPanel>
                                        <ToggleButton x:Name="TglAutostart" Style="{StaticResource Switch}" DockPanel.Dock="Right"
                                                      VerticalAlignment="Center" Checked="Autostart_Changed" Unchecked="Autostart_Changed" />
                                        <StackPanel>
                                            <TextBlock Text="Запускать при входе в Windows" Style="{StaticResource CardTitle}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="TokenHub откроется сразу после входа в систему" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,14,0,0">
                                        <ToggleButton x:Name="TglMinimized" Style="{StaticResource Switch}" DockPanel.Dock="Right"
                                                      VerticalAlignment="Center" Checked="Minimized_Changed" Unchecked="Minimized_Changed" />
                                        <StackPanel>
                                            <TextBlock Text="Запускать свёрнутым в трей" Style="{StaticResource CardTitle}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="Окно не появится — сразу заработает только значок у часов" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Модель по умолчанию" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                               Text="TokenHub запишет её в opencode.json. Список — модели, которые отдаёт Token Harbor." />
                                    <ComboBox x:Name="CmbModel" Style="{StaticResource Picker}" Margin="0,12,0,0"
                                              SelectionChanged="Model_Changed"
                                              AutomationProperties.Name="Модель по умолчанию" />
                                    <DockPanel Margin="0,16,0,0">
                                        <ToggleButton x:Name="TglFreeOnly" Style="{StaticResource Switch}" DockPanel.Dock="Right"
                                                      VerticalAlignment="Center"
                                                      Checked="FreeOnly_Changed" Unchecked="FreeOnly_Changed" />
                                        <StackPanel>
                                            <TextBlock Text="Только бесплатные модели" Style="{StaticResource CardTitle}" />
                                            <TextBlock Style="{StaticResource Caption}"
                                                       Text="Прокси не пропустит платную модель, даже если её запросит OpenCode." />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Резервная копия" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                               Text="Полная копия настроек (ключи, тема, режим пула) одним файлом. Ключи в копии зашифрованы DPAPI и открываются только на этом компьютере." />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Style="{StaticResource SubtleButton}" Content="Сохранить копию" Margin="0,0,8,8" Click="BackupAll_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Восстановить из копии" Margin="0,0,8,8" Click="RestoreAll_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Диагностика" Margin="0,0,8,8" Click="ExportDiagnostics_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Файлы" Style="{StaticResource CardTitle}" />
                                    <TextBlock x:Name="SettingsPaths" Style="{StaticResource Mono}" Margin="0,10,0,0" Text="…" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Style="{StaticResource SubtleButton}" Content="Настройки TokenHub" Click="OpenHubFolder_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Конфиг OpenCode" Margin="8,0,0,0" Click="OpenConfig_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Проект прокси" Margin="8,0,0,0" Click="OpenProxyFolder_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ================= status bar ================= -->
            <Border Grid.Row="2" Background="{DynamicResource Br.Control}" BorderBrush="{DynamicResource Br.CardBorder}" BorderThickness="0,1,0,0"
                    Cursor="Hand" ToolTip="Открыть журнал событий"
                    MouseLeftButtonUp="StatusBar_Click">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Br.Muted}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtStatus" Margin="8,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource Br.TextSecondary}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock x:Name="TxtLastEvent" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,104,0" FontSize="12"
                               Foreground="{DynamicResource Br.TextSecondary}" />
                    <ProgressBar x:Name="BusyRing" Width="90" Height="3" IsIndeterminate="True"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
