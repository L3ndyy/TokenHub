<Window x:Class="TokenHub.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenHub — настройка OpenCode"
        Height="560" Width="640" MinHeight="460" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Br.Popup}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Первый запуск" Style="{StaticResource Title}" />
            <TextBlock Style="{StaticResource Subtitle}" Text="Настроим OpenCode за один шаг" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Ключ Token Harbor" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap">
                            Вставьте ключ вида thk_live_… — он показывается один раз на
                            <Hyperlink Click="OpenTokenHarbor_Click"
                                       Foreground="{DynamicResource Br.Accent}">tokenharbor.ai</Hyperlink>
                            в карточке Universal Key. Аккаунт бесплатный, карта не нужна; скопируйте
                            ключ сразу — повторно его не показывают. Остальные ключи можно добавить
                            позже в разделе «Ключи».
                        </TextBlock>
                        <TextBox x:Name="TxtKey" Style="{StaticResource Field}" Margin="0,12,0,0"
                                 AutomationProperties.Name="Ключ Token Harbor" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel>
                            <ToggleButton x:Name="TglSkills" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock x:Name="TxtSkillsTitle" Text="Установить скиллы" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="TxtSkillsDetail" Style="{StaticResource Caption}" Margin="0,4,10,0"
                                           TextWrapping="Wrap" Text="Готовые наборы инструкций для OpenCode." />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Что будет сделано" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="TxtOpenCode" Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtPlan" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="TxtStatus" Style="{StaticResource Caption}" Margin="0,12,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource Br.Danger}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SubtleButton}" Content="Позже" Click="Later_Click" />
            <Button Style="{StaticResource AccentButton}" Content="Готово" Margin="8,0,0,0" Click="Done_Click" />
        </StackPanel>
    </Grid>
</Window>