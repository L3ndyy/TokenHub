<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

        <!-- ============ scales ============ -->
        <!-- Radii: Sm = chips and icon actions, Md = controls, Lg = cards and popups. -->
        <CornerRadius x:Key="Rad.Sm">6</CornerRadius>
        <CornerRadius x:Key="Rad.Md">8</CornerRadius>
        <CornerRadius x:Key="Rad.Lg">12</CornerRadius>

        <!-- ============ palette (dark values, theme service overrides them) ============ -->
        <SolidColorBrush x:Key="Br.Layer" Color="#59000000" />
        <SolidColorBrush x:Key="Br.Popup" Color="#FF1B1B1F" />
        <SolidColorBrush x:Key="Br.Card" Color="#10FFFFFF" />
        <SolidColorBrush x:Key="Br.CardBorder" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="Br.Text" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="Br.TextSecondary" Color="#B0FFFFFF" />
        <SolidColorBrush x:Key="Br.Control" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="Br.ControlHover" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="Br.ControlBorder" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="Br.Accent" Color="#FF4CC2FF" />
        <SolidColorBrush x:Key="Br.OnAccent" Color="#FF0A0A0A" />
        <SolidColorBrush x:Key="Br.AccentBorder" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="Br.Success" Color="#FF6CCB5F" />
        <SolidColorBrush x:Key="Br.Danger" Color="#FFFF99A4" />
        <SolidColorBrush x:Key="Br.DangerSoft" Color="#33C42B1C" />
        <SolidColorBrush x:Key="Br.DangerBorder" Color="#66C42B1C" />
        <SolidColorBrush x:Key="Br.Muted" Color="#8AFFFFFF" />
        <SolidColorBrush x:Key="Br.ScrollTrack" Color="#00000000" />
        <SolidColorBrush x:Key="Br.ScrollThumb" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="Br.ScrollThumbHover" Color="#66FFFFFF" />

        <!-- ============ text ============ -->
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="27" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
        </Style>

        <Style x:Key="Subtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Br.TextSecondary}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
        </Style>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Br.Text}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Br.TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Br.TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Every number is tabular, so the live counters stop jittering as they tick (V3). -->
        <Style TargetType="TextBlock">
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <!-- ============ surfaces ============ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Br.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Br.CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Rad.Lg}" />
            <Setter Property="Padding" Value="24" />
        </Style>
</ResourceDictionary>
